# Copy to .env
# Public origin, used for canonical URLs, sitemap.xml and structured data.
SITE_URL="http://localhost:3000"

# Read-only database login for the website (SELECT on the directory tables only).
# Remote databases also need their CA certificate at certs/supabase-ca.crt (see README).
WEB_DATABASE_URL="postgresql://web_reader.<project>:<password>@<host>:6543/postgres"

# Form inbox login (INSERT on submissions and listing_requests only). Reviews, claims, edits and new places go here.
WRITE_DATABASE_URL="postgresql://web_writer.<project>:<password>@<host>:5432/postgres"
